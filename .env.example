VITE_API_BASE_URL=http://localhost:8000/api/v1
# Enables the local demo API. Never enable this in a deployed environment.
VITE_USE_MOCK_API=false

# Despliegue: demo (por defecto) | client
# VITE_DEPLOYMENT_KIND=demo

# Identidad institucional — sustituir en producción sin tocar componentes
# VITE_INSTITUTION_PRODUCT_NAME=ADIT SYSTEM
# VITE_INSTITUTION_NAME=Instituto Demo de Gestión Ciudadana
# VITE_INSTITUTION_ENVIRONMENT_TAGLINE=Entorno demostrativo
# VITE_INSTITUTION_PRIVACY_RESPONSIBLE=Instituto Demo de Gestión Ciudadana
# VITE_INSTITUTION_DEMO_DISCLAIMER=Este es un entorno demostrativo y utiliza información ficticia. No ingreses datos personales reales.
# VITE_INSTITUTION_LOGO_URL=https://cdn.ejemplo.test/logo.svg
# VITE_INSTITUTION_LOGO_ALT=Logotipo institucional
# VITE_INSTITUTION_CONTACT_EMAIL=privacidad@ejemplo.test
# VITE_INSTITUTION_CONTACT_PHONE=+52 55 0000 0000
# VITE_INSTITUTION_PRIVACY_INTEGRAL_PATH=/privacidad
# VITE_INSTITUTION_PRIVACY_SUMMARY_PATH=/privacidad/simplificado
# VITE_INSTITUTION_LEGAL_NOTICE_PATH=/aviso-legal
# VITE_INSTITUTION_COPYRIGHT_HOLDER=ADIT SYSTEM
# VITE_INSTITUTION_COPYRIGHT_YEAR=2026

# Producción cliente (ejemplo):
# VITE_DEPLOYMENT_KIND=client
# VITE_INSTITUTION_NAME=[Institución cliente]
# VITE_INSTITUTION_ENVIRONMENT_TAGLINE=
# VITE_INSTITUTION_PRIVACY_RESPONSIBLE=[Institución cliente]
